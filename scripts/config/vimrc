" install vim-plug automatically
let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

" vim-plug plugins
call plug#begin()
Plug 'ojroques/vim-oscyank', {'branch': 'main'}
call plug#end()

" vim oscyank plugin
nmap <leader>c <Plug>OSCYankOperator
nmap <leader>cc <leader>c_
vmap <leader>c <Plug>OSCYankVisual
" remap leader key from \ to Spacebar
let mapleader = "\<Space>"

" my preferences
set tabstop=2
set shiftwidth=2
set expandtab " tabs become spaces
set background=dark
set autoindent
syntax on

" let vim use system clipboard for every copy/paste automatically
" without putting to registers "+yy
" NOTE: requires vim to have clipboard compiled - gvim/vim-gtk
set clipboard=unnamedplus

" :W to save with sudo if forgot to open with it
command W :execute ':silent w !sudo tee % > /dev/null' | :edit!

" Remember position when reopening files
if has("autocmd")
  " When editing a file, always jump to the last cursor position
  autocmd BufReadPost * if line("'\"") > 0 && line ("'\"") <= line("$") | exe "normal! g`\"" | endif
endif
